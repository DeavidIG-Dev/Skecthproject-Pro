<?xml version="1.0" encoding="utf-8"?>
<resources>

	<style name="Widget.ComponentMaterial3.ShapeableImageView.Rounded" parent="">
		<item name="cornerSize">7.5dp</item>
		<item name="cornerFamily">rounded</item>
	</style>

	<style name="Widget.ComponentMaterial.ComponentMaterialTextInputLayout.Outline" parent="" />

	<style name="Widget.ComponentMaterial.ComponentMaterialTextInputLayout.Outline.Joined" parent="" />

	<style name="Widget.ComponentMaterial.ComponentMaterialTextInputLayout.Filled" parent="" />

	<style name="Widget.ComponentMaterial.ComponentIconButton" parent="android:Widget">
		<item name="android:background">@null</item>
		<item name="android:scaleType">fitCenter</item>
		<item name="android:focusable">true</item>
		<item name="android:clickable">true</item>
		<item name="containerSize">40dp</item>
		<item name="iconSize">24dp</item>
	</style>

	<style name="Widget.ComponentMaterial.ComponentIconButton.Filled" parent="Widget.ComponentMaterial.ComponentIconButton">
		<item name="fillColor">?attr/colorPrimary</item>
		<item name="strokeColor">@android:color/transparent</item>
		<item name="strokeWidth">0dp</item>
		<item name="iconTint">?attr/colorOnPrimary</item>
	</style>

	<style name="Widget.ComponentMaterial.ComponentIconButton.Outline" parent="Widget.ComponentMaterial.ComponentIconButton">
		<item name="fillColor">@android:color/transparent</item>
		<item name="strokeColor">?attr/colorOutline</item>
		<item name="strokeWidth">1dp</item>
		<item name="iconTint">?attr/colorOnSurfaceVariant</item>
	</style>

	<style name="Widget.ComponentMaterial.ComponentMaterialButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
		<item name="android:textColor">@color/tab_icon_m3_selector</item>
		<item name="backgroundTint">@color/tab_background_m3_selector</item>
		<item name="iconTint">@color/tab_icon_m3_selector</item>
		<item name="iconGravity">textStart</item>
		<item name="iconPadding">4dp</item>
		<item name="shapeAppearanceOverlay">@style/ShapeAppearance.Pill</item>
		<item name="elevation">0dp</item>
		<item name="rippleColor">@android:color/transparent</item>
	</style>

	<style name="ShapeAppearance.Pill" parent="ShapeAppearance.MaterialComponents.SmallComponent">
		<item name="cornerSize">50%</item>
	</style>

	<attr name="darkGrey" format="color">#FF808080</attr>
</resources>