<?xml version="1.0" encoding="utf-8"?>
<com.deavidig.mod.deanielig.textinput.widget.ComponentTextInputLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	app:hintText="Name module"
	app:hintEnable="true"
	app:placeholderEnable="true"
	app:placeholderText="core"
	app:counterEnable="true"
	app:counterLimit="true"
	app:counterMaxLength="20"
	app:prefixEnable="true"
	app:prefixText=":"
	app:layout_constraintEnd_toEndOf="parent"
	app:layout_constraintHorizontal_bias="0.0"
	app:layout_constraintStart_toStartOf="parent"
	app:layout_constraintTop_toBottomOf="@+id/divider">

	<com.google.android.material.textfield.TextInputEditText
		android:id="@+id/name_filter"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:singleLine="true" />

</com.deavidig.mod.deanielig.textinput.widget.ComponentTextInputLayout>