<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<androidx.core.widget.NestedScrollView
		android:id="@+id/nested_scroll"
		android:layout_width="wrap_content"
		android:layout_height="0dp"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent">

		<com.deavidig.mod.deaniel.navigation.railview.widget.ComponentNavigationRailView
			android:id="@+id/modules_gradle"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			app:headerLayout="@layout/activity_project_creator_gradle_property_floatingactionbutton"
			app:menu="@menu/activity_project_creator_gradle_navigationrailview_defualt" />

	</androidx.core.widget.NestedScrollView>

	<androidx.viewpager2.widget.ViewPager2
		android:id="@+id/modules_pager_gradle"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:orientation="horizontal"
		android:paddingHorizontal="10dp"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toEndOf="@+id/nested_scroll"
		app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>