<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:layout_marginBottom="48dp">

	<com.deavidig.mod.deanielig.floatingactionbutton.FloatingActionButtonMenu
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:icon="@drawable/ic_add_24"
		android:text="New Module"
		app:activeMenuBy="longclick"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent">

		<com.deavidig.mod.deanielig.floatingactionbutton.FloatingActionButtonItem
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			app:icon="@drawable/ic_settings_backup_restore_24"
			android:text="Restore Module" />

	</com.deavidig.mod.deanielig.floatingactionbutton.FloatingActionButtonMenu>

</androidx.constraintlayout.widget.ConstraintLayout>