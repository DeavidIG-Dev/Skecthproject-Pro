<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
    android:layout_height="match_parent"
	android:paddingBottom="12dp">

	<com.deavidig.mod.deaniel.divider.widget.ComponentMaterialDivider
		android:id="@+id/divider"
		android:layout_width="64dp"
		android:layout_height="4dp"
		android:layout_marginTop="16dp"
		app:dividerColor="?attr/colorSurfaceContainerHigh"
		app:dividerRadiusSize="14dp"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintHorizontal_bias="0.498"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent" />

	<com.deavidig.mod.deaniel.textinput.widget.ComponentMaterialTextInputLayout
		android:id="@+id/name_filter_container"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="8dp"
		android:layout_marginTop="24dp"
		app:hintText="Rename Filter"
		app:hintEnable="true"
		app:placeholderEnable="true"
		app:placeholderText="Gaming"
		app:counterEnabled="true"
		app:counterMaxLength="20"
		app:endIconMode="clear_text"
		app:helperText="Leave the field blank to delete."
		app:helperEnable="true"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintHorizontal_bias="0.0"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@+id/divider">

		<com.google.android.material.textfield.TextInputEditText
			android:id="@+id/name_filter"
			android:layout_width="match_parent"
			android:layout_height="match_parent" />

	</com.deavidig.mod.deaniel.textinput.widget.ComponentMaterialTextInputLayout>

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@+id/name_filter_container">

		<com.google.android.material.button.MaterialButton
			style="@style/Widget.Material3.Button.OutlinedButton"
			android:id="@+id/cancel_button"
			android:layout_marginHorizontal="4dp"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="Cancel"/>

		<com.google.android.material.button.MaterialButton
			android:id="@+id/accept_button"
			android:layout_marginHorizontal="4dp"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="Accept" />

	</LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>